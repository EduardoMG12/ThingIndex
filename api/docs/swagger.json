                    },
                    {
                        "type": "string",
                        "description": "Opaque cursor returned by the previous audit page",
                        "name": "cursor",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Search over title, detail, origin and request correlation",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Audit action filter",
                        "name": "action",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Audit status filter",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Actor type filter",
                        "name": "actor_type",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Actor ID filter",
                        "name": "actor_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Request correlation ID filter",
                        "name": "correlation_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Document ID filter",
                        "name": "document_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Collection ID filter",
                        "name": "collection_id",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Inclusive start timestamp in RFC3339",
                        "name": "created_from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Inclusive end timestamp in RFC3339",
                        "name": "created_to",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
