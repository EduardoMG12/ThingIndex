# Server Configuration
PORT=8080
LOG_LEVEL=info

# Crawler Configuration
CRAWLER_START_URL=https://example.com/start.pdf
CRAWLER_TIMEOUT=10s
CRAWLER_MAX_DEPTH=3
CRAWLER_RETRIES=3
CRAWLER_IGNORE_KEYWORDS=legislação,lei,decreto,consumidor
CRAWLER_FILTER_NAME=leis

# Storage Configuration
# Options: local, s3, gcs (currently only local is implemented)
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./output_pdfs

# AWS Configuration (Placeholder for future use)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=

# GCP Configuration (Placeholder for future use)
# GOOGLE_APPLICATION_CREDENTIALS=
# GCS_BUCKET_NAME=
