# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_AUTH=neo4j/your_secure_password
NEO4J_PLUGINS=["apoc", "graph-data-science"]

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=your_rabbitmq_password

# Crawler Configuration
RABBITMQ_URL=amqp://guest:your_rabbitmq_password@rabbitmq:5672/
RABBITMQ_QUEUE=crawler_tasks
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=/app/output_pdfs
CRAWLER_TIMEOUT=2m
CRAWLER_RETRIES=3
CRAWLER_IGNORE_KEYWORDS=Mensagem de Veto,VIDE ADI 5322
CRAWLER_FILTER_NAME=direitos_do_consumidor_tree_depth
CRAWLER_CONCURRENCY=2
CRAWLER_BACKPRESSURE_LIMIT=10000
QUEUE_TYPE=rabbitmq

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=your_access_key
MINIO_SECRET_KEY=your_secret_key
MINIO_USE_SSL=false

# Server Configuration
PORT=8080
LOG_LEVEL=info

# Telemetry
TELEMETRY_EXCHANGE=pipeline_telemetry

