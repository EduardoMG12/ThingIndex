# ThingIndex local development environment
# This file is tuned for Docker Compose by default.
# If you run the API directly on the host, adjust DB_HOST, DB_PORT and MINIO_ENDPOINT.

# Application
APP_ENV=development
PORT=8080
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL container bootstrap
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thingindex

# API database connection
# Docker Compose overrides DB_HOST and DB_PORT for the api container.
# When you run the API directly on the host against the compose database,
# use the published PostgreSQL port 5434.
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=thingindex
DB_SSLMODE=disable

# Frontend API configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
API_INTERNAL_URL=http://api:8080/api/v1

# Security
JWT_SECRET=thingindex-local-jwt-secret-not-for-production
MASTER_ENCRYPTION_KEY=thingindex-local-master-key-not-for-production
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ALLOW_PRIVATE_STORAGE_ENDPOINTS=false

# Storage
# STORAGE_PROVIDER controls the default runtime storage used when no user-specific
# storage provider is enabled. Supported bootstrap providers: MINIO, GCP_STORAGE.
STORAGE_PROVIDER=MINIO
# For Docker Compose keep MINIO_ENDPOINT=minio:9000
# For manual host execution usually use MINIO_ENDPOINT=localhost:9000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=thingindex-local-access-key
MINIO_SECRET_KEY=thingindex-local-secret-key
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=thingindex-docs
# Native Google Cloud Storage bootstrap
# Use GCP_STORAGE_EMULATOR_HOST for local development with the bundled emulator,
# or fill GCP_STORAGE_CREDENTIALS_JSON with a service-account JSON payload.
GCP_STORAGE_PROJECT_ID=thingindex-dev
GCP_STORAGE_BUCKET_NAME=thingindex-docs
GCP_STORAGE_LOCATION=us-central1
GCP_STORAGE_CREDENTIALS_JSON=
GCP_STORAGE_EMULATOR_HOST=
MAX_UPLOAD_SIZE_BYTES=20971520

# Mail / password reset
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY_MODE=none
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@thingindex.com
RESET_PASSWORD_URL=http://localhost:3000/reset-password

# Server timeouts
SERVER_READ_TIMEOUT_SECONDS=15
SERVER_WRITE_TIMEOUT_SECONDS=30
SERVER_IDLE_TIMEOUT_SECONDS=60

# Optional / roadmap infrastructure
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Optional test overrides for backend integration/e2e
# Leave empty to reuse the normal local stack from this same .env file.
THINGINDEX_TEST_DB_HOST=
THINGINDEX_TEST_DB_PORT=
THINGINDEX_TEST_DB_USER=
THINGINDEX_TEST_DB_PASSWORD=
THINGINDEX_TEST_DB_NAME=
THINGINDEX_TEST_DB_SSLMODE=
THINGINDEX_TEST_MINIO_ENDPOINT=
THINGINDEX_TEST_MINIO_ACCESS_KEY=
THINGINDEX_TEST_MINIO_SECRET_KEY=
THINGINDEX_TEST_MINIO_USE_SSL=
THINGINDEX_TEST_GCP_EMULATOR_HOST=
THINGINDEX_TEST_GCP_PROJECT_ID=
THINGINDEX_TEST_GCP_LOCATION=
THINGINDEX_TEST_RABBITMQ_URL=

# Optional real LLM integration tests
# Disabled by default. When enabled, tests still skip the real AI paths unless the
# matching flags below are true. In devcontainer/API containers, prefer
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1 when Ollama runs on the host.
THINGINDEX_TEST_LLM_ENABLED=false
THINGINDEX_TEST_LLM_PROVIDER=
THINGINDEX_TEST_LLM_API_KEY=
THINGINDEX_TEST_LLM_BASE_URL=
THINGINDEX_TEST_LLM_MODEL=
THINGINDEX_TEST_LLM_RUN_MODEL_DISCOVERY=false
THINGINDEX_TEST_LLM_RUN_PROCESSING=false

# Provider-specific fallbacks for the optional real LLM tests
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=openai/gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_BASE_URL=
GEMINI_MODEL=
CLAUDE_API_KEY=
CLAUDE_BASE_URL=
CLAUDE_MODEL=
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Docker Compose dev cache paths (optional)
# The stack script auto-detects these when Go is installed on the host.
THINGINDEX_GO_MOD_CACHE=
THINGINDEX_GO_BUILD_CACHE=
