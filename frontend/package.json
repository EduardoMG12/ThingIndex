{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "next dev --turbo -H 0.0.0.0",
    "dev:e2e": "next dev --webpack -H 127.0.0.1 -p ${THINGINDEX_E2E_PORT:-3000}",
    "storybook": "pnpm run build:storybook && python3 -m http.server 6006 --bind 0.0.0.0 --directory storybook-static",
    "storybook:test-server": "python3 -m http.server 6006 --bind 127.0.0.1 --directory storybook-static",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "build:storybook": "HOME=/tmp/thingindex-storybook-home STORYBOOK_DISABLE_TELEMETRY=1 STORYBOOK_DISABLE_CRASH_REPORTS=1 storybook build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real": "playwright test --config=playwright.real.config.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:e2e:install": "playwright install chromium",
    "test:storybook": "pnpm run build:storybook && pnpm run test:storybook:e2e",
    "test:storybook:e2e": "playwright test -c playwright.storybook.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^0.575.0",
    "next": "16.2.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^14.4.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.3.1",
    "@storybook/addon-docs": "10.3.1",
    "@storybook/addon-vitest": "10.3.1",
    "@storybook/nextjs-vite": "10.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "storybook": "10.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "sharp": ">=0.35.0"
    }
  }
}
