---
title: Fluxo de Processamento - ThingIndex
---
flowchart TB
    subgraph Upload["1. Upload"]
        U[Usuário envia PDF]
        V[Valida tipo MIME]
    end

    subgraph Storage["2. Armazenamento"]
        S[Object Storage]
        P[(PostgreSQL)]
    end

    subgraph Fila["3. Fila"]
        O[Outbox]
        MQ[(RabbitMQ)]
        D[Dispatcher]
    end

    subgraph Indexador["4. Indexação"]
        W[Worker Indexer]
        PARSE[Parser]
        EXTRAI[Extração de Estruturas]
        LLM[Enriquecimento c/ LLM]
    end

    subgraph Final["5. Finalização"]
        TELE[Registro de Telemetria]
        STATUS[Atualiza Status]
    end

    U --> V
    V --> S
    V --> P
    P --> O
    O --> MQ
    MQ --> D
    D --> W
    W --> PARSE
    W --> S
    PARSE --> EXTRAI
    EXTRAI --> P
    EXTRAI --> LLM
    LLM --> P
    W --> STATUS
    W --> TELE

    style Upload fill:#E3F2FD,stroke:#1565C0
    style Storage fill:#FFF3E0,stroke:#E65100
    style Fila fill:#F3E5F5,stroke:#6A1B9A
    style Indexador fill:#E8F5E9,stroke:#2E7D32
    style Final fill:#FFEBEE,stroke:#C62828
