classDiagram
    class User {
        +UUID id
        +String name
        +String email
        +String password_hash
        +DateTime created_at
        +login()
        +resetPassword()
    }

    class Category {
        +UUID id
        +String name
        +String description
        +UUID user_id
        +DateTime created_at
    }

    class Collection {
        +UUID id
        +String name
        +String description
        +UUID user_id
        +UUID category_id
        +DateTime created_at
        +getContext()
    }

    class Document {
        +UUID id
        +UUID user_id
        +UUID collection_id
        +String filename
        +String mime_type
        +BigInt size_bytes
        +String checksum_sha256
        +String storage_path
        +String status
        +DateTime created_at
        +DateTime processed_at
        +upload()
        +getStructures()
    }

    class ParagraphNode {
        +UUID id
        +UUID document_id
        +Int page_number
        +Int sequence_order
        +Text content
        +String heading_level
        +String heading_text
    }

    class TableSection {
        +UUID id
        +UUID document_id
        +Int sequence_order
        +Int page_number
        +String caption
        +JSONB headers
        +JSONB rows
    }

    class DocumentPage {
        +UUID id
        +UUID document_id
        +Int page_number
        +Text content
        +Int estimated_tokens
    }

    class MetadataPair {
        +UUID id
        +UUID document_id
        +String key
        +Text value
    }

    class DocumentChunk {
        +UUID id
        +UUID document_id
        +String chunk_type
        +String title
        +Int sequence_order
        +Text content
        +JSONB source_paragraph_ids
    }

    class DocumentOutlineNode {
        +UUID id
        +UUID document_id
        +UUID parent_id
        +Int level
        +String title
        +Int sequence_order
        +String path
    }

    class OutboxEvent {
        +UUID id
        +String aggregate_type
        +UUID aggregate_id
        +String event_type
        +JSONB payload
        +Boolean published
        +DateTime created_at
    }

    class ProcessingAttempt {
        +UUID id
        +UUID document_id
        +Int attempt_number
        +String status
        +String error_message
        +DateTime created_at
    }

    class AuditEvent {
        +UUID id
        +UUID document_id
        +UUID user_id
        +String action
        +JSONB details
        +DateTime created_at
    }

    class ProviderConfig {
        +UUID id
        +UUID user_id
        +String provider_type
        +String encrypted_api_key
        +String model_name
        +Boolean is_active
    }

    class ChatConversation {
        +UUID id
        +UUID user_id
        +UUID collection_id
        +String title
        +DateTime created_at
        +askQuestion()
    }

    class ChatMessage {
        +UUID id
        +UUID conversation_id
        +String role
        +Text content
        +JSONB cited_sources
        +DateTime created_at
    }

    User "1" --> "N" Category
    User "1" --> "N" Collection
    User "1" --> "N" Document
    User "1" --> "N" ProviderConfig
    User "1" --> "N" ChatConversation

    Category "1" --> "N" Collection

    Collection "1" --> "N" Document
    Collection "1" --> "N" ChatConversation

    Document "1" --> "N" ParagraphNode
    Document "1" --> "N" TableSection
    Document "1" --> "N" DocumentPage
    Document "1" --> "N" MetadataPair
    Document "1" --> "N" DocumentChunk
    Document "1" --> "N" DocumentOutlineNode
    Document "1" --> "N" ProcessingAttempt
    Document "1" --> "N" AuditEvent
    Document "1" --> "N" OutboxEvent

    DocumentOutlineNode "1" --> "N" DocumentOutlineNode : parent_id

    ChatConversation "1" --> "N" ChatMessage
