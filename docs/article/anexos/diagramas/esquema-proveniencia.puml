@startuml
' GERADO por scripts/gera-esquema-proveniencia.py a partir do DBML. Nao edite a mao.
!include estilo.iuml
skinparam defaultFontSize 13
skinparam linetype ortho
hide circle
package "Núcleo" {
entity "users" as users {
  {field} <b>PK</b> id : serial
  {field} email : varchar(255)
}
entity "collections" as collections {
  {field} <b>PK</b> id : serial
  {field} user_id : integer
  {field} name : varchar(255)
}
entity "documents" as documents {
  {field} <b>PK</b> id : serial
  {field} user_id : integer
  {field} <i>FK</i> collection_id : integer
  {field} title : varchar(255)
  {field} status : varchar(50)
}
}
package "Estrutura extraída (coordenada de origem)" {
entity "document_pages" as document_pages {
  {field} <b>PK</b> id : serial
  {field} <i>FK</i> document_id : integer
  {field} page_number : integer
  {field} content : text
}
entity "paragraph_nodes" as paragraph_nodes {
  {field} <b>PK</b> id : serial
  {field} <i>FK</i> document_id : integer
  {field} sequence_order : integer
  {field} page_number : integer
  {field} content : text
  {field} metadata : jsonb
}
entity "table_sections" as table_sections {
  {field} <b>PK</b> id : serial
  {field} <i>FK</i> document_id : integer
  {field} sequence_order : integer
  {field} page_number : integer
  {field} headers : jsonb
  {field} rows : jsonb
}
entity "document_outline_nodes" as document_outline_nodes {
  {field} <b>PK</b> id : serial
  {field} <i>FK</i> document_id : integer
  {field} <i>FK</i> parent_id : integer
  {field} level : integer
  {field} title : varchar(255)
  {field} start_page : integer
  {field} end_page : integer
}
entity "document_chunks" as document_chunks {
  {field} <b>PK</b> id : serial
  {field} <i>FK</i> document_id : integer
  {field} sequence_order : integer
  {field} page_number : integer
  {field} content : text
}
entity "metadata_pairs" as metadata_pairs {
  {field} <b>PK</b> id : serial
  {field} <i>FK</i> document_id : integer
  {field} key : varchar(255)
  {field} value : text
}
}
package "Fora do caminho da proveniência (16 tabelas, Anexo A9)" as infra {
entity "demais tabelas" as outras {
  chat_conversation_entries
  chat_conversations
  document_audit_events
  document_categories
  document_processing_attempts
  enrichment_cache_entries
  model_price_histories
  model_prices
  outbox_events
  paragraph_highlights
  pricing_sources
  provider_audit_events
  provider_model_catalogs
  user_indexing_preferences
  user_provider_configs
  workspace_view_states
}
}
documents ||--o{ document_chunks
documents ||--o{ document_outline_nodes
document_outline_nodes ||--o{ document_outline_nodes
documents ||--o{ document_pages
collections ||-right-o{ documents
documents ||--o{ metadata_pairs
documents ||--o{ paragraph_nodes
documents ||--o{ table_sections
users ||.right.o{ collections
users ||.right.o{ documents
metadata_pairs -[hidden]right- outras
@enduml
