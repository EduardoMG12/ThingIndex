flowchart TB
    Q["Pergunta"] --> TOK["Tokenização<br/>acento e caixa dobrados,<br/>variante singular/plural<br/>e numérica"]
    Q -. "opcional<br/>(desligada por padrão)" .-> EXP["Expansão da pergunta<br/>por LLM, com cache<br/>por hash da pergunta"]
    EXP -.-> TOK
    DB[("PostgreSQL<br/>9 consultas fixas<br/>por coleção")] --> UN
    subgraph UN["Unidades pontuadas por BM25 (k1 = 1,2; b = 0,75)"]
        direction TB
        P["Páginas"]
        S["Seções do sumário"]
        C["Trechos"]
        T["Linhas de tabela<br/>(exige 2 termos<br/>significativos)"]
    end
    TOK --> UN
    UN --> SEL["Seleção de fontes<br/>até 3 linhas de tabela<br/>mais até 6 seções e páginas,<br/>desempate estável"]
    SEL --> F["Fontes com coordenada<br/>documento, página,<br/>linhas e caixa"]
    F --> LLM["Redação pelo LLM<br/>só a partir das fontes"]
    F --> UI["Workspace abre o PDF<br/>na página e marca a caixa"]
    LLM --> R["Resposta citando<br/>as fontes"]
